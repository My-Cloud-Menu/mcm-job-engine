# ── Supabase ─────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...
DATABASE_URL=postgresql://postgres:password@db.your-project.supabase.co:5432/postgres

# ── Worker (override per service in Easy Panel) ───────────────
WORKER_QUEUE_NAME=pos_injection
# Optional: filter by integration (comma-separated). Leave blank to accept all.
WORKER_INTEGRATIONS=
WORKER_MAX_CONCURRENT_JOBS=10
WORKER_POLL_INTERVAL_MS=2000
WORKER_LOCK_DURATION_SECONDS=180
WORKER_HEARTBEAT_INTERVAL_MS=60000
WORKER_PORT=3000
# Set true only on ONE service replica
RUN_SCHEDULER=false
RUN_ALERT_DISPATCHER=false

# ── Circuit Breaker ───────────────────────────────────────────
# APAGADO por defecto (2026-08-06). Encendido, un POS caído frenaba el sync de TODOS los sites
# de la integración y no se reanudaba solo al volver. Las tres variables de abajo sólo aplican
# con CB_ENABLED=true.
CB_ENABLED=false
CB_THRESHOLD=10
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=300

# ── Observability – PostHog ───────────────────────────────────
POSTHOG_API_KEY=
POSTHOG_HOST=https://us.posthog.com

# ── Alerts – Resend ──────────────────────────────────────────
RESEND_API_KEY=
ALERT_FROM_EMAIL=alerts@visionarysoft.com
ALERT_EMAILS=csantos@mycloudmenu.com
# Cupos por CARRIL (034): el ruido de warning/info de un site no puede silenciar un critical.
ALERT_RATE_LIMIT_PER_HOUR=20            # warning/info, global por destinatario
ALERT_RATE_LIMIT_CRITICAL_PER_HOUR=60   # carril propio de critical
ALERT_RATE_LIMIT_PER_SITE_PER_HOUR=6    # techo por site (sólo warning/info)

# ── Logging ──────────────────────────────────────────────────
LOG_LEVEL=info
NODE_ENV=production
